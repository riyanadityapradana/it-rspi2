# Salin pengaturan yang diperlukan ke it-rspi2/.env. Jangan simpan kredensial asli di Git.
PORTAL_DB_HOST=192.168.1.108
PORTAL_DB_DATABASE=it-rspi
PORTAL_DB_PORT=3306
# Opsional: URL portal yang dapat dijangkau pemohon, tanpa slash akhir.
# Gunakan ini jika aplikasi berada di belakang reverse proxy atau memakai hostname khusus.
# PORTAL_PUBLIC_URL=https://it.example.org/it-rspi2/portal-tiket
# Opsional: lokasi sesi dan SQLite CAPTCHA portal (default storage/portal-security).
# PORTAL_SECURITY_PATH=C:/xampp/htdocs/it-rspi2/storage/portal-security
# PORTAL_DB_USERNAME=akun_aplikasi
# PORTAL_DB_PASSWORD=isi_di_env_lokal

# IP telah dikonfirmasi: 192.168.1.4 (bukan 192.198.1.4).
PORTAL_PEGAWAI_HOST=192.168.1.4
PORTAL_PEGAWAI_DATABASE=sik9
PORTAL_PEGAWAI_PORT=3306
# Gunakan akun khusus dengan hak SELECT pada sik9.pegawai jika tersedia.
# PORTAL_PEGAWAI_USERNAME=akun_select_pegawai
# PORTAL_PEGAWAI_PASSWORD=isi_di_env_lokal

# Notifikasi tiket baru memakai bot/destinasi bersama modul cuti/lembur/pengajuan.
# CHANNEL_ID didahulukan dari CHAT_ID. Isi kredensial asli hanya di .env lokal.
# Bot harus boleh mengirim ke tujuan IT RSPI.
# TELEGRAM_BOT_TOKEN=token_bot_dari_botfather
# TELEGRAM_CHANNEL_ID=id_chat_atau_username_channel_it_rspi
# TELEGRAM_CHAT_ID=alternatif_jika_channel_id_kosong
# TELEGRAM_MESSAGE_THREAD_ID=id_topik_opsional
# Aktif secara default; 0 menonaktifkan notifikasi portal saja (mis. pengujian).
# PORTAL_TELEGRAM_ENABLED=1
